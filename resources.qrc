<RCC>
    <qresource prefix="/qml">
        <file alias="CalendarDialog.qml">qml/CalendarDialog.qml</file>
        <file alias="DatePopup.qml">qml/DatePopup.qml</file>
        <file alias="Dates.js">qml/Dates.js</file>
        <file alias="EventBlock.qml">qml/EventBlock.qml</file>
        <file alias="EventDialog.qml">qml/EventDialog.qml</file>
        <file alias="EventLine.qml">qml/EventLine.qml</file>
        <file alias="EventMouseArea.qml">qml/EventMouseArea.qml</file>
        <file alias="ImportDialog.qml">qml/ImportDialog.qml</file>
        <file alias="Main.qml">qml/Main.qml</file>
        <file alias="MiniMonth.qml">qml/MiniMonth.qml</file>
        <file alias="MonthView.qml">qml/MonthView.qml</file>
        <file alias="NavigationButton.qml">qml/NavigationButton.qml</file>
        <file alias="ScopeDialog.qml">qml/ScopeDialog.qml</file>
        <file alias="SearchResults.qml">qml/SearchResults.qml</file>
        <file alias="SettingsDialog.qml">qml/SettingsDialog.qml</file>
        <file alias="Sidebar.qml">qml/Sidebar.qml</file>
        <file alias="TimeGridView.qml">qml/TimeGridView.qml</file>
        <file alias="YearView.qml">qml/YearView.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="add.svg">icons/add.svg</file>
        <file alias="sidebar.svg">icons/sidebar.svg</file>
    </qresource>
</RCC>
